            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/libros?autor=Grupo QA {{runId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "libros"
              ],
              "query": [
                {
                  "key": "autor",
                  "value": "Grupo QA {{runId}}"
                }
