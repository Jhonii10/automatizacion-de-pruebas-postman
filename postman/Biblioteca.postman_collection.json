              "path": [
                "api",
                "libros"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isbn\": \"{{isbnUnico}}\",\n  \"titulo\": \"Libro de ejemplar único\",\n  \"autor\": \"Grupo QA\",\n  \"anio\": 2024,\n  \"ejemplares\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Prestar libro disponible",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Verificación cruzada: consulta el libro para confirmar el stock",
                  "function verificarDisponibles(libroId, esperado, nombre) {",
                  "  pm.sendRequest({",
                  "    url: pm.variables.get('baseUrl') + '/api/libros/' + libroId,",
                  "    method: 'GET',",
                  "    header: { 'X-API-KEY': pm.variables.get('apiKey') }",
                  "  }, (err, res) => {",
                  "    pm.test(nombre, () => {",
                  "      pm.expect(err).to.be.null;",
                  "      pm.expect(res.json().disponibles).to.eql(esperado);",
                  "    });",
                  "  });",
                  "}",
                  "",
                  "const p = pm.response.json();",
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Préstamo queda ACTIVO y sin fecha de devolución', () => {",
                  "  pm.expect(p.estado).to.eql('ACTIVO');",
                  "  pm.expect(p.fechaDevolucion).to.be.null;",
                  "});",
                  "pm.test('Fecha límite = fecha de préstamo + 14 días', () => {",
                  "  const dias = (new Date(p.fechaLimite) - new Date(p.fechaPrestamo)) / 86400000;",
                  "  pm.expect(dias).to.eql(14);",
                  "});",
                  "pm.collectionVariables.set('prestamoId', p.id);",
                  "verificarDisponibles(p.libroId, 0, 'Stock del libro bajó a 0');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/prestamos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "prestamos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"libroId\": {{libroUnicoId}},\n  \"usuario\": \"{{usuario}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Prestar sin ejemplares retorna 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('Mensaje indica falta de ejemplares', () => pm.expect(pm.response.json().mensaje).to.include('Sin ejemplares'));"
                ]
