                  "pm.test('El filtro retorna solo el libro del grupo', () => {",
                  "  pm.expect(lista).to.be.an('array').with.lengthOf(1);",
                  "  pm.expect(lista[0].id).to.eql(Number(pm.collectionVariables.get('libroId')));",
                  "});"
                ]
