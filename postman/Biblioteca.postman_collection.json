{
  "info": {
    "name": "Biblioteca API - Pruebas funcionales",
    "description": "Taller grupal U2. Ejecutar en orden con el Collection Runner o con Newman (npm run test:api).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-KEY",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Validaciones comunes, se ejecutan después de cada petición de la colección",
          "pm.test('[común] Tiempo de respuesta < 1000 ms', () => {",
          "  pm.expect(pm.response.responseTime).to.be.below(1000);",
          "});",
          "if (pm.response.code !== 204) {",
          "  pm.test('[común] Respuesta en formato JSON', () => {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 Salud",
      "item": [
        {
          "name": "Verificar salud del servicio",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Identificador único de la corrida: hace la colección repetible sin reiniciar la API",
                  "const runId = Date.now().toString();",
                  "pm.collectionVariables.set('runId', runId);",
                  "pm.collectionVariables.set('usuario', 'usuario-' + runId);",
                  "pm.collectionVariables.set('usuarioLimite', 'lector-' + runId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Servicio UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
