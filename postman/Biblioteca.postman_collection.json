    {
      "name": "02 Libros",
      "item": [
        {
          "name": "Crear libro válido",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// ISBN de 13 dígitos único por corrida",
                  "pm.collectionVariables.set('isbn', '978' + pm.collectionVariables.get('runId').slice(-10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const schemaLibro = {",
                  "  type: 'object',",
                  "  required: ['id', 'isbn', 'titulo', 'autor', 'anio', 'ejemplares', 'disponibles'],",
                  "  properties: {",
                  "    id: { type: 'integer', minimum: 1 },",
                  "    isbn: { type: 'string', pattern: '^\\\\d{13}$' },",
                  "    titulo: { type: 'string', minLength: 1 },",
                  "    autor: { type: 'string', minLength: 1 },",
                  "    anio: { type: 'integer' },",
                  "    ejemplares: { type: 'integer', minimum: 0 },",
                  "    disponibles: { type: 'integer', minimum: 0 }",
                  "  }",
                  "};",
                  "pm.collectionVariables.set('schemaLibro', JSON.stringify(schemaLibro));",
                  "",
                  "const libro = pm.response.json();",
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Cabecera Location apunta al recurso', () => {",
                  "  pm.expect(pm.response.headers.get('Location')).to.eql('/api/libros/' + libro.id);",
                  "});",
                  "pm.test('Cumple el esquema JSON de Libro', () => pm.response.to.have.jsonSchema(schemaLibro));",
                  "pm.test('Disponibles = ejemplares al crear', () => pm.expect(libro.disponibles).to.eql(libro.ejemplares));",
                  "pm.test('ISBN coincide con el enviado', () => pm.expect(libro.isbn).to.eql(pm.collectionVariables.get('isbn')));",
                  "pm.collectionVariables.set('libroId', libro.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/libros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "libros"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isbn\": \"{{isbn}}\",\n  \"titulo\": \"Pruebas de Software en la Práctica\",\n  \"autor\": \"Grupo QA {{runId}}\",\n  \"anio\": 2024,\n  \"ejemplares\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Consultar libro por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const schemaLibro = JSON.parse(pm.collectionVariables.get('schemaLibro'));",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Cumple el esquema JSON de Libro', () => pm.response.to.have.jsonSchema(schemaLibro));",
                  "pm.test('Es el libro creado', () => pm.expect(pm.response.json().isbn).to.eql(pm.collectionVariables.get('isbn')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/libros/{{libroId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "libros",
                "{{libroId}}"
              ]
            }
          }
        },
        {
