              "raw": "{\n  \"libroId\": {{libroUnicoId}},\n  \"usuario\": \"{{usuario}}-b\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Devolver préstamo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Verificación cruzada: consulta el libro para confirmar el stock",
                  "function verificarDisponibles(libroId, esperado, nombre) {",
                  "  pm.sendRequest({",
                  "    url: pm.variables.get('baseUrl') + '/api/libros/' + libroId,",
                  "    method: 'GET',",
                  "    header: { 'X-API-KEY': pm.variables.get('apiKey') }",
                  "  }, (err, res) => {",
                  "    pm.test(nombre, () => {",
                  "      pm.expect(err).to.be.null;",
                  "      pm.expect(res.json().disponibles).to.eql(esperado);",
                  "    });",
                  "  });",
                  "}",
                  "",
                  "const p = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Estado DEVUELTO con fecha de devolución', () => {",
                  "  pm.expect(p.estado).to.eql('DEVUELTO');",
                  "  pm.expect(p.fechaDevolucion).to.not.be.null;",
                  "});",
                  "verificarDisponibles(p.libroId, 1, 'Stock del libro se repuso a 1');"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/prestamos/{{prestamoId}}/devolucion",
